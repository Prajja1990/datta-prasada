# Datta Prasada - Environment Configuration

# Supabase Backend (Optional for local test / Required for live cloud sync)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Razorpay Online Payment Gateway
# Obtain Key ID from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
# Leave empty to use built-in interactive simulated payment gateway
VITE_RAZORPAY_KEY_ID=

# Restaurant Configuration
VITE_RESTAURANT_NAME="Datta Prasada"
VITE_OUTLET_LOCATION="Balagere, Bangalore"
VITE_TOKEN_PREFIX="DP-"
